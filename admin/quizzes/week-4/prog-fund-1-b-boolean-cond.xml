  <question type="multichoice">
    <name>
      <text>B7: Short-circuit AND</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which statement about <code>&amp;&amp;</code> is true?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100">
      <text>Right-hand side is not evaluated if left-hand side is false</text>
      <feedback format="html">
        <text><![CDATA[✔ Short-circuit behaviour.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Both sides always evaluate</text>
      <feedback format="html">
        <text><![CDATA[That’s &amp; (bitwise) or languages without short-circuit.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>RHS is skipped when LHS is true</text>
      <feedback format="html">
        <text><![CDATA[That describes || short-circuit, not &&.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>It performs bitwise AND on booleans</text>
      <feedback format="html">
        <text><![CDATA[That’s single ampersand & with booleans.]]></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>B8: Short-circuit OR</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which statement about <code>||</code> is true?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100">
      <text>RHS is not evaluated if LHS is true</text>
      <feedback format="html">
        <text><![CDATA[✔ Short-circuit OR.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>RHS is not evaluated if LHS is false</text>
      <feedback format="html">
        <text><![CDATA[If LHS is false, RHS must be checked.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Both sides always evaluate</text>
      <feedback format="html">
        <text><![CDATA[Not for ||; it short-circuits.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>It’s the same as | on booleans</text>
      <feedback format="html">
        <text><![CDATA[Single | evaluates both sides.]]></text>
      </feedback>
    </answer>
