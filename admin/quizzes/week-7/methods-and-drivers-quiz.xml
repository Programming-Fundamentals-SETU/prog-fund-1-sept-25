      <feedback>
        <text>Wrong variable — should use F.</text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>(C + 32) × 9/5</text>
      <feedback>
        <text>That’s Celsius to Fahrenheit.</text>
      </feedback>
    </answer>
  </question>
