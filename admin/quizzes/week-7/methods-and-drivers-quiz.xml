<?xml version="1.0" ?>
<quiz>
  <question type="multichoice">
    <name>
      <text>Q1: Why do we use methods in Java?</text>
    </name>
    <questiontext format="html">
      <text>&lt;![CDATA[What is the main reason we use methods in Java?]]&gt;</text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0">
      <text>To make programs run slower</text>
      <feedback>
        <text>Methods make code faster and more efficient, not slower.</text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>To avoid reusing code</text>
      <feedback>
        <text>Methods encourage reuse, not avoid it.</text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>To organise code into reusable blocks</text>
      <feedback>
        <text>Correct! Methods group related code into reusable, modular sections.</text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>To make code longer</text>
      <feedback>
        <text>Methods actually shorten and simplify code.</text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>Q2: Keyword for methods with no return value</text>
    </name>
    <questiontext format="html">
      <text>&lt;![CDATA[What keyword is used when a method does not return any value?]]&gt;</text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0">
      <text>null</text>
      <feedback>
        <text>`null` is a value, not a return type.</text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>none</text>
      <feedback>
        <text>Not a valid Java keyword.</text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>void</text>
      <feedback>
        <text>Correct! `void` means no value is returned.</text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>empty</text>
      <feedback>
        <text>No such keyword in Java syntax.</text>
      </feedback>
    </answer>
  </question>
