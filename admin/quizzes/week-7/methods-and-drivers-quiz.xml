    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0">
      <text>(F + 32) × 5/9</text>
      <feedback>
        <text>That adds instead of subtracting.</text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>(F − 32) × 5/9</text>
      <feedback>
        <text>Correct! Subtract 32, then multiply by 5/9.</text>
      </feedback>
    </answer>
    <answer fraction="0">
