  <question type="multichoice">
    <name>
      <text>C3: Else-if chain</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What prints for <code>age = 15</code>?</p><pre><code>if (age &lt; 13) {
    System.out.println("Child");
} else if (age &lt; 19) {
    System.out.println("Teenager");
} else {
    System.out.println("Adult");
}</code></pre>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="0">
      <text>Child</text>
      <feedback format="html">
        <text><![CDATA[15 is not &lt; 13.]]></text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>Teenager</text>
      <feedback format="html">
        <text><![CDATA[✔ 15 &lt; 19 and previous condition is false.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Adult</text>
      <feedback format="html">
        <text><![CDATA[Else runs only if both earlier conditions are false.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Nothing</text>
      <feedback format="html">
        <text><![CDATA[One of the branches always runs.]]></text>
      </feedback>
    </answer>
