  <question type="multichoice">
    <name>
      <text>C5: Braces optionality</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which two snippets are equivalent?</p><pre><code>// A
if (price &lt; 50) {
    price = 50;
}

// B
