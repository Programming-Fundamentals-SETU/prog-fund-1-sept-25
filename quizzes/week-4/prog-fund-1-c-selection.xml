    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100">
      <text>A and B are equivalent when the block has one statement</text>
      <feedback format="html">
        <text><![CDATA[✔ Braces optional with a single statement.]]></text>
