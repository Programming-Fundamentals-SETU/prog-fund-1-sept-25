    price = 50;</code></pre>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
