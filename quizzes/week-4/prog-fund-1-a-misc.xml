  <question type="multichoice">
    <name>
      <text>A10: Precedence mnemonic</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which mnemonic best matches Java’s arithmetic precedence order presented (brackets, multiplication/division, addition/subtraction)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100">
      <text>BODMAS / PEMDAS</text>
      <feedback format="html">
        <text><![CDATA[✔ Brackets, Orders (exponents), Division/Multiplication, Addition/Subtraction (Java lacks exponent operator).]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>ASMDOB</text>
      <feedback format="html">
        <text><![CDATA[This reverses the usual order.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>SADBOM</text>
      <feedback format="html">
        <text><![CDATA[Not a standard mnemonic.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>MDASBO</text>
      <feedback format="html">
        <text><![CDATA[Brackets happen first, then MDAS.]]></text>
      </feedback>
    </answer>
