  <question type="multichoice">
    <name>
      <text>A4: Compound assignment (+=)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What does this statement do?</p><pre><code>x += 5;</code></pre>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[]]></text>
    </generalfeedback>
    <defaultgrade>1.000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100">
      <text>Increases x by 5</text>
      <feedback format="html">
        <text><![CDATA[✔ Equivalent to x = x + 5.]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Sets x to 5</text>
      <feedback format="html">
        <text><![CDATA[That would be x = 5;]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Multiplies x by 5</text>
      <feedback format="html">
        <text><![CDATA[That is x *= 5;]]></text>
      </feedback>
    </answer>
    <answer fraction="0">
      <text>Divides x by 5</text>
      <feedback format="html">
        <text><![CDATA[That is x /= 5;]]></text>
      </feedback>
    </answer>
  </question>
